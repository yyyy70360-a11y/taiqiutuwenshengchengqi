[Unit]
Description=Billiards Matrix API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=billiards
Group=billiards
WorkingDirectory=/opt/billiards-api
EnvironmentFile=/etc/billiards-api/server.env
ExecStart=/opt/billiards-api/billiards_api
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/billiards-api

[Install]
WantedBy=multi-user.target
